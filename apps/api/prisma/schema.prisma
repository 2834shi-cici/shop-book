// shop-book Prisma schema
// 数据模型 SSOT：docs/prd/shop-book-v1.md › 数据模型（Prisma）

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BookingStatus {
  BOOKED
  DONE
  NO_SHOW
  CANCELLED
}

model Customer {
  id        String    @id @default(cuid())
  openid    String    @unique
  createdAt DateTime  @default(now())
  bookings  Booking[]
}

model Staff {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model TimeSlot {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  startTime String   @db.VarChar(5) // "HH:mm"
  endTime   String   @db.VarChar(5) // "HH:mm"
  booked    Boolean  @default(false)
  booking   Booking?

  @@unique([date, startTime])
}

model Booking {
  id         String        @id @default(cuid())
  customerId String
  slotId     String        @unique
  petName    String
  petBreed   String
  status     BookingStatus @default(BOOKED)
  createdAt  DateTime      @default(now())
  verifiedAt DateTime?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  slot     TimeSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
}
