{
  "name": "shop-book",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "pnpm --filter ./apps/api dev",
    "build": "pnpm -r build",
    "db:migrate": "pnpm --filter ./apps/api prisma migrate dev",
    "db:seed": "pnpm --filter ./apps/api prisma db seed",
    "db:studio": "pnpm --filter ./apps/api prisma studio",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
